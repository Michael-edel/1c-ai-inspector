POSTGRES_DB=one_c_ai_inspector
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-local-secret
POSTGRES_PORT=5432

MIGRATION_DB_USER=inspector_migration
MIGRATION_DB_PASSWORD=replace-with-local-secret
RUNTIME_DB_USER=inspector_runtime
RUNTIME_DB_PASSWORD=replace-with-local-secret

DATABASE_URL=postgresql+psycopg://inspector_runtime:replace-with-local-secret@postgres:5432/one_c_ai_inspector
MIGRATION_DATABASE_URL=postgresql+psycopg://inspector_migration:replace-with-local-secret@postgres:5432/one_c_ai_inspector
MCP_SERVER_URL=http://host.docker.internal:8001/mcp
MCP_TRANSPORT=streamable-http
MCP_BRIDGE_TOKEN=
MCP_LIVE_PROBE_URL=http://127.0.0.1:8091
MCP_SMOKE_TOOL=get_configuration_info
MCP_SMOKE_ARGUMENTS={}
MCP_PROJECTS_TOOL=
MCP_POLICY_PATH=/app/mcp_policy.yaml
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.5
MODEL_API_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-with-local-secret
MODEL_INPUT_COST_PER_1K=0
MODEL_OUTPUT_COST_PER_1K=0
APP_ENVIRONMENT=sandbox
WORKER_POLL_INTERVAL_SEC=1
WORKER_LEASE_TIMEOUT_SEC=600

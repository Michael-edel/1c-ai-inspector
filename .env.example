POSTGRES_DB=one_c_ai_inspector
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-local-secret
POSTGRES_PORT=5432

MIGRATION_DB_USER=inspector_migration
MIGRATION_DB_PASSWORD=replace-with-local-secret
RUNTIME_DB_USER=inspector_runtime
RUNTIME_DB_PASSWORD=replace-with-local-secret

DATABASE_URL=postgresql+psycopg://inspector_runtime:replace-with-local-secret@postgres:5432/one_c_ai_inspector
MIGRATION_DATABASE_URL=postgresql+psycopg://inspector_migration:replace-with-local-secret@postgres:5432/one_c_ai_inspector
MCP_SERVER_URL=http://host.docker.internal:8001/mcp
MCP_TRANSPORT=streamable-http
MCP_BRIDGE_TOKEN=
MCP_LIVE_PROBE_URL=http://127.0.0.1:8091
MCP_SMOKE_TOOL=get_configuration_info
MCP_SMOKE_ARGUMENTS={}
MCP_PROJECTS_TOOL=get_configuration_info
MCP_PATCH_SEARCH_TOOL=search_code
MCP_PATCH_SEARCH_ARGUMENT=query
MCP_POLICY_PATH=/app/mcp_policy.yaml
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.5
MODEL_API_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-with-local-secret
MODEL_INPUT_COST_PER_1K=0.005
MODEL_CACHED_INPUT_COST_PER_1K=0.0005
MODEL_OUTPUT_COST_PER_1K=0.03
MODEL_MAX_OUTPUT_TOKENS=16384
MODEL_INPUT_TOKEN_ESTIMATE_CHARS=3
MODEL_PROMPT_OVERHEAD_TOKENS=4000
USD_KZT_RATE=464.71
USD_KZT_RATE_DATE=2026-07-14
USD_KZT_RATE_SOURCE=nationalbank.kz
MODEL_RETRIES=1
MAX_TOOL_CALLS=30
MAX_RESULT_CHARS=500000
MAX_MCP_RESULT_BYTES=3000000
MAX_TASK_MCP_BYTES=12000000
MAX_MODEL_RESPONSE_BYTES=2000000
MAX_CONTEXT_CHARS=120000
MAX_FINDINGS=100
MAX_METHODS_READ=10
TASK_TIMEOUT_SEC=300
MAX_REQUEST_BYTES=12000000
TRAFFIC_WARNING_BYTES=5000000000
TRAFFIC_CRITICAL_BYTES=8000000000
TRAFFIC_HARD_LIMIT_BYTES=9800000000
APP_ENVIRONMENT=sandbox
# Optional read-only repository mount used by POST /checkpoint/git.
PATCH_GIT_REPOSITORY=
PATCH_GIT_HOST_PATH=
# Disabled by default. These values must point only to disposable sandbox storage.
SANDBOX_EXECUTOR_ENABLED=false
SANDBOX_SOURCE_REPOSITORY=
SANDBOX_ROOT=
SANDBOX_SOURCE_HOST_PATH=
SANDBOX_ROOT_HOST_PATH=
SANDBOX_VALIDATION_COMMAND=
# JSON argv only, for example: ["python","-m","compileall","-q","."]
SANDBOX_TEST_COMMAND=
# JSON argv only; point this to tests against a disposable test environment.
SANDBOX_COMMAND_TIMEOUT_SEC=300
INSPECTOR_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
INSPECTOR_AUTH_SECRET_PREVIOUS=
INSPECTOR_AUTH_SECRET_PREVIOUS_UNTIL=
INSPECTOR_PACKAGE_SIGNING_SECRET=
INSPECTOR_AUTH_MODE=signed
# Required when INSPECTOR_AUTH_MODE=jwks
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ROLES_CLAIM=roles
AUTH_SUBJECT_CLAIM=sub
AUTH_JWKS_CACHE_TTL_SEC=300
KEYCLOAK_PUBLIC_URL=https://idp.example.com
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-keycloak-db-secret-at-least-24-chars
KEYCLOAK_ADMIN_USERNAME=inspector-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-keycloak-admin-secret-at-least-24-chars
KEYCLOAK_HOST_PORT=8081
APP_DOMAIN=inspector.example.com
IDP_DOMAIN=idp.example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
WORKER_POLL_INTERVAL_SEC=1
WORKER_HEARTBEAT_INTERVAL_SEC=15
WORKER_LEASE_TIMEOUT_SEC=600
